---
// src/layouts/BaseLayout.astro
// 1. Importamos los componentes que acabamos de crear
import Navigation from '../components/astro/Navigation.astro';
import Footer from '../components/astro/Footer.astro';
import '../styles/global.css';

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(`${import.meta.env.BASE_URL}/fotos/shareimage.webp`, Astro.site).href;
---


<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href=`${import.meta.env.BASE_URL}/images/favicon.svg` />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description || "Mi portfolio profesional"} />
    <title>{title || "Rafa | Desarrollador & Docente"}</title>

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content="Rafa | Desarrollador Full Stack & Docente" />
  <meta property="og:description" content="Portfolio personal y docente sobre desarrollo de software, proyectos y publicaciones técnicas." />
  <meta property="og:image" content={ogImageUrl} />

  <!-- Twitter / X -->
  <meta property="twitter:card" content="summary_large_image" />
  <meta property="twitter:url" content={canonicalURL} />
  <meta property="twitter:title" content="Rafa | Desarrollador Full Stack & Instructor" />
  <meta property="twitter:description" content="Portfolio personal y docente sobre desarrollo de software, proyectos y publicaciones técnicas." />
  <meta property="twitter:image" content={ogImageUrl} />
    
  </head>
  <body>
    
    <!-- 2. Colocamos la barra de navegación arriba -->
    <Navigation />
    
    <main>
      <!-- 3. Aquí sigue encajando el "slot" (el contenido cambiante de cada página) -->
      <slot />
    </main>
    
    <!-- 4. Colocamos el pie de página abajo -->
    <Footer />
    
  </body>
</html>